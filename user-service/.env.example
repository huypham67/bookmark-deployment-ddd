APP_PORT=8080
SERVICE_NAME=user-service
APP_HOST_NAME=/api/user_service

DB_HOST=user-db
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=user_db
DB_SSLMODE=disable
DB_TIMEZONE=UTC

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DATABASE=0

RATELIMIT_LIMIT=20
RATELIMIT_WINDOW=10s

JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ISSUER=user-service
JWT_AUDIENCE=bookmark-app
JWT_EXPIRATION_SECONDS=3600

# New Relic APM (required). The license key is a secret — leave blank here and set it in .env.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=user-service
